  <!-- Banner -->
  <div class="bg-gradient-to-r from-sagreen via-slate-900 to-sablue text-white text-xs py-2 px-4 text-center font-medium shadow-inner">
    <span class="bg-sagold text-slate-900 px-2 py-0.5 rounded-full font-bold text-[10px] mr-2">2026/2027</span>
