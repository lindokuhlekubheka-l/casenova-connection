  </div>

  <main class="max-w-4xl mx-auto my-8 px-4 w-full flex-grow">
    
    <!-- Progress Header -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-bold text-slate-900">Student Application Form</h2>
        <span id="stepBadge" class="text-xs font-bold px-3 py-1 bg-emerald-100 text-sagreen rounded-full border border-emerald-300">Step 1 of 3</span>
      </div>
      
      <!-- Progress Bar -->
      <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden flex">
        <div id="progressBar" class="bg-sagreen h-full w-1/3 transition-all duration-500 ease-out"></div>
      </div>
      <div class="grid grid-cols-3 text-center text-xs font-bold text-slate-500 mt-2">
        <span id="lblStep1" class="text-sagreen">1. Personal Info</span>
        <span id="lblStep2">2. Academics</span>
        <span id="lblStep3">3. Documents & Submit</span>
      </div>
    </div>

    <!-- Application Form -->
    <form id="appForm" onsubmit="handleFormSubmit(event)" class="bg-white p-6 sm:p-8 rounded-2xl shadow-md border border-slate-200 space-y-6">
      
      <!-- STEP 1: Personal Details -->
      <div id="step1" class="space-y-5">
        <h3 class="text-base font-bold text-slate-900 border-b pb-2 flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-sagreen text-white text-xs flex items-center justify-center">1</span>
          Personal Identification & Contact
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Full Name & Surname *</label>
            <input type="text" id="full_name" required minlength="3" placeholder="e.g. Thabo Molefe"
              class="w-full px-3 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-sagreen focus:border-sagreen outline-none text-sm transition">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">SA ID Number (13 Digits) *</label>
            <input type="text" id="id_number" required maxlength="13" placeholder="e.g. 0204155800083" oninput="validateSAID()"
              class="w-full px-3 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-sagreen focus:border-sagreen outline-none text-sm transition font-mono">
            <p id="idError" class="text-[11px] text-sared font-semibold mt-1 hidden"></p>
            <p id="dobNotice" class="text-[11px] text-sagreen font-semibold mt-1 hidden"></p>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Phone Number (SA Format) *</label>
            <input type="tel" id="phone" required placeholder="0821234567" pattern="^0[0-9]{9}$" title="10 digits starting with 0"
              class="w-full px-3 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-sagreen focus:border-sagreen outline-none text-sm transition">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email Address *</label>
            <input type="email" id="email" required placeholder="student@example.co.za"
              class="w-full px-3 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-sagreen focus:border-sagreen outline-none text-sm transition">
          </div>

          <div class="md:col-span-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Province *</label>
            <select id="province" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-sagreen focus:border-sagreen outline-none text-sm bg-white transition">
              <option value="">Select Province...</option>
              <option value="Eastern Cape">Eastern Cape</option>
              <option value="Free State">Free State</option>
              <option value="Gauteng">Gauteng</option>
              <option value="KwaZulu-Natal">KwaZulu-Natal</option>
              <option value="Limpopo">Limpopo</option>
              <option value="Mpumalanga">Mpumalanga</option>
              <option value="Northern Cape">Northern Cape</option>
              <option value="North West">North West</option>
              <option value="Western Cape">Western Cape</option>
            </select>
          </div>
        </div>

        <div class="flex justify-end pt-4">
          <button type="button" onclick="nextStep(2)" class="bg-sagreen hover:bg-emerald-700 text-white font-bold px-6 py-2.5 rounded-lg text-sm shadow transition flex items-center gap-2">
            Next: Academics & Institution &rarr;
          </button>
        </div>
      </div>

      <!-- STEP 2: Academic Details -->
      <div id="step2" class="space-y-5 hidden">
        <h3 class="text-base font-bold text-slate-900 border-b pb-2 flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-sagreen text-white text-xs flex items-center justify-center">2</span>
          Academic Results & Preferred Institution
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Select University (ONLY ONE) *</label>
            <select id="university" required class="w-full px-3 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-sagreen focus:border-sagreen outline-none text-sm bg-white transition font-medium">
              <option value="">Choose Institution...</option>
              <option value="University of Johannesburg (UJ)">University of Johannesburg (UJ)</option>
              <option value="University of Pretoria (UP)">University of Pretoria (UP)</option>
              <option value="University of Cape Town (UCT)">University of Cape Town (UCT)</option>
              <option value="University of the Witwatersrand (Wits)">University of the Witwatersrand (Wits)</option>
              <option value="University of South Africa (UNISA)">University of South Africa (UNISA)</option>
              <option value="Tshwane University of Technology (TUT)">Tshwane University of Technology (TUT)</option>
              <option value="University of Limpopo">University of Limpopo</option>
              <option value="University of KwaZulu-Natal (UKZN)">University of KwaZulu-Natal (UKZN)</option>
              <option value="University of the Free State (UFS)">University of the Free State (UFS)</option>
              <option value="Cape Peninsula University of Technology (CPUT)">Cape Peninsula University of Technology (CPUT)</option>
              <option value="Durban University of Technology (DUT)">Durban University of Technology (DUT)</option>
              <option value="Central University of Technology (CUT)">Central University of Technology (CUT)</option>
              <option value="Vaal University of Technology (VUT)">Vaal University of Technology (VUT)</option>
              <option value="Mangosuthu University of Technology (MUT)">Mangosuthu University of Technology (MUT)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Course / Qualification *</label>
            <input type="text" id="course" required placeholder="e.g. Bachelor of Commerce in Accounting"
              class="w-full px-3 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-sagreen focus:border-sagreen outline-none text-sm transition">
          </div>
        </div>

        <!-- Subject Results Table -->
        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Matric Subjects & Marks (Min 6 Required) *</label>
            <div class="text-xs bg-slate-100 px-3 py-1 rounded-full text-slate-700 font-bold">
              Auto APS Score: <span id="calculatedAps" class="text-sagreen text-sm font-black">0</span> | Avg: <span id="calculatedAvg" class="text-sablue text-sm font-black">0%</span>
            </div>
          </div>

          <div class="overflow-x-auto border border-slate-200 rounded-lg">
            <table class="w-full text-left border-collapse text-xs">
              <thead class="bg-slate-100 text-slate-700 uppercase font-bold border-b border-slate-200">
                <tr>
                  <th class="p-2.5">Subject</th>
                  <th class="p-2.5 w-28">Mark %</th>
                  <th class="p-2.5 w-20 text-center">Level</th>
                  <th class="p-2.5 w-12 text-center">Action</th>
                </tr>
